Number = {11},
Pages = {1439-1453},
Abstract = {Data interoperability and synchronization among heterogeneous data
   providers in collaborative e-health systems are challenging research
   issues. Efficient data management techniques promote an efficient way of
   sharing data. This paper describes existing approaches to data
   interoperability (platform independency) for exchanging and
   synchronizing data between heterogeneous data sources or various
