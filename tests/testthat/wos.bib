@article{ WOS:000407637200002,
Author = {Law, Kuok Kei and Chan, Andrew},
Title = {Managing knowledge work in Asia Pacific contexts: case studies of Hong
   Kong SMEs},
Journal = {ASIA PACIFIC BUSINESS REVIEW},
Year = {2017},
Volume = {23},
Number = {4},
Pages = {475-492},
Abstract = {This study explores how knowledge creation and sharing practices are
   fostered in a sample of small- and medium-sized enterprises (SMEs) in
   Hong Kong. Our analysis indicates that three types of managerial
   interventions - initiating intervention, reinforcing intervention and
   aligning intervention - are particularly useful to promote knowledge
   management activities among employees. Such findings provide insights
   into researchers and managers on the important role of managerial
   interventions in knowledge management (KM) as well as the idiosyncrasies
   of KM in SMEs in Chinese societies.},
