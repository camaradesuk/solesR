@article{ WOS:000432285200002,
Author = {Ioannidis, John P. A. and Bhattacharya, Siladitya and Evers, J. L. H.
   and van der Veen, Fulco and Somigliana, Edgardo and Barratt, Christopher
   L. R. and Bontempi, Gianluca and Baird, David T. and Crosignani,
   PierGiorgio and Devroey, Paul and Diedrich, Klaus and Farquharson, Roy
   G. and Fraser, Lynn R. and Geraedts, Joep P. M. and Gianaroli, Luca and
   La Vecchia, Carlo and Lundin, Kersti and Magli, Cristina and Negri, Eva
   and Sunde, Arne and Tapanainen, Juha S. and Tarlatzis, Basil C. and Van
   Steirteghem, Andre and Veiga, Anna and ESHRE Capri Workshop Grp},
Title = {Protect us from poor-quality medical research},
Journal = {HUMAN REPRODUCTION},
Year = {2018},
Volume = {33},
Number = {5},
Pages = {770-776},
Month = {MAY},
Abstract = {Much of the published medical research is apparently flawed, cannot be
   replicated and/or has limited or no utility. This article presents an
   overview of the current landscape of biomedical research, identifies
   problems associated with common study designs and considers potential
   solutions. Randomized clinical trials, observational studies, systematic
   reviews and meta-analyses are discussed in terms of their inherent
   limitations and potential ways of improving their conduct, analysis and
   reporting. The current emphasis on statistical significance needs to be
   replaced by sound design, transparency and willingness to share data
   with a clear commitment towards improving the quality and utility of
   clinical research.},
