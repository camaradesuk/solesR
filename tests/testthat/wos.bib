@article{ WOS:000521648700002,
Author = {Chatterjee, Sheshadri and Sreenivasulu, N. S.},
Title = {Personal Data Sharing and Legal Issues of Human Rights in the Era of
   Artificial Intelligence: Moderating Effect of Government Regulation},
Journal = {INTERNATIONAL JOURNAL OF ELECTRONIC GOVERNMENT RESEARCH},
Year = {2019},
Volume = {15},
Number = {3},
Pages = {21-36},
Month = {JUL-SEP},
Abstract = {Personal data sharing has become an important issue in public and
   private sectors of our society. However, data subjects are perceived to
   be always unwilling to share their data on security and privacy reasons.
   They apprehend that those data will be misused at the cost of their
   privacy jeopardising their human rights. Thus, personal data sharing is
   closely associated with human right issues. This concern of data
   subjects has increased manifolds owing to the interference of Artificial
   Intelligence (AI) since AI can analyse data without human intervention.
   In this background, this article has taken an attempt to investigate how
   applications of AI and imposition of regulatory controls with
   appropriate governance can influence the impact of personal data sharing
   on the issues of human right abuses.},
