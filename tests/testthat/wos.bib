@article{ WOS:000269040100011,
Author = {Adamson, Mary A. and Vincent, Audrey A. and Cundiff, Jeff},
Title = {COMMON GROUND, NOT A BATTLE GROUND Violence Prevention at a
   Detoxification Facility},
Journal = {JOURNAL OF PSYCHOSOCIAL NURSING AND MENTAL HEALTH SERVICES},
Year = {2009},
Volume = {47},
Number = {8},
Pages = {28-35},
Month = {AUG},
Abstract = {This article evaluates the results of a workplace violence prevention
   program implemented in a Colorado detoxification facility. The program
   interventions are modeled after federal Occupational Safety and Health
   Administration guidelines and use theories from both nursing and
