@article{ WOS:000529189000079,
Author = {Wang, Yi and Zhang, Rui and Liang, Zhenchang and Li, Shaohua},
Title = {Grape-RNA: A Database for the Collection, Evaluation, Treatment, and
   Data Sharing of Grape RNA-Seq Datasets},
Journal = {GENES},
Year = {2020},
Volume = {11},
Number = {3},
Month = {MAR},
Abstract = {Since its inception, RNA sequencing (RNA-seq) has become the most
   effective way to study gene expression. After more than a decade of
   development, numerous RNA-seq datasets have been created, and the full
   utilization of these datasets has emerged as a major issue. In this
   study, we built a comprehensive database named Grape-RNA, which is
   focused on the collection, evaluation, treatment, and data sharing of
   grape RNA-seq datasets. This database contains 1529 RNA-seq samples, 112
   microRNA samples from the public platform, and 485 RNA-seq in-house
   datasets sequenced by our lab. We classified these data into 25
   conditions and provide the sample information, cleaned raw data,
   expression level, assembled unigenes, useful tools, and other relevant
   information to the users. Thus, this study provides data and tools that
   should be beneficial for researchers by allowing them to easily use the
   RNA-seq. The provided information can greatly contribute to grape
   breeding and genomic and biological research. This study may improve the
   usage of RNA-seq.},
