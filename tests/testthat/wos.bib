@article{ WOS:001020812600001,
Author = {Owens, Donna C.},
Title = {Poetic representation in program evaluation: an integrated model},
Journal = {JOURNAL OF POETRY THERAPY},
Year = {2023},
Month = {2023 JUL 7},
Abstract = {An evaluation was conducted of a community trauma program based in a
   local church to guide improvement, expansion, and replication efforts.
   While conducting interviews an unexpected pattern of language emerged,
   and in the creation of the evaluation report a poetic representation was
   included as an offering to the interviewees who had shared their time,
   their stories, and their words. This article explores poetic
   representation as an option for sharing evaluation data, presents a
   model for evaluating poetic representation, and encourages evaluators to
   explore creative mechanisms for sharing with research and evaluation
   participants.},
