@article{ WOS:000880654600112,
Author = {Zheng, Xu and Tian, Ling and Cai, Zhipeng},
Title = {A Fair and Rational Data Sharing Strategy Toward Two-Stage Industrial
   Internet of Things},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2023},
Volume = {19},
Number = {1},
Pages = {1088-1096},
Month = {JAN},
Abstract = {The easy and pervasive involvement of devices in Industrial Internet of
   Things has greatly benefited the implementation and adoption of various
   smart services. One prominent prerequisite of such trends is the
   extensive and continuous support and sharing of data and resources among
   devices. However, previous efforts usually treat the data sharing as
   one-time task among devices, which are incapable when the data are
   applied for the distributed and iterative training task of machine
   learning models. Therefore, this article proposes a novel framework for
   continuous data sharing in Industrial Internet of Things. The system
   consists of different system owners, each brings devices and participate
   the distributed training of models. Specifically, system owners hold
   different scales of devices, data, and resources, while devices own
   heterogeneous availability in different time periods. In this case, the
   goal is to properly assign devices for qualified model training process
   in different rounds, such that no devices will devote unlimited
   resources and the overall efforts and consumptions among different
   owners are balanced. Accordingly, three algorithms for device allocation
   are proposed, based on whether the availability of devices in each
   training round are known at the beginning of the training procedure. The
   analysis shows that all algorithms can achieve a rational allocation for
   devices and balance the performance among system owners. Finally,
   evaluation results reveal that the proposed solutions outperform
   baseline methods in providing better data sharing plans.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article},
Language = {English},
Affiliation = {Tian, L (Corresponding Author), Univ Elect Sci \& Technol China, Sch Comp Sci \& Engn, Chengdu 611731, Peoples R China.
   Zheng, Xu; Tian, Ling, Univ Elect Sci \& Technol China, Sch Comp Sci \& Engn, Chengdu 611731, Peoples R China.
   Tian, Ling, Shenzhen Inst Informat Technol, Shenzhen 518172, Peoples R China.
   Cai, Zhipeng, Georgia State Univ, Dept Comp Sci, Atlanta, GA 30302 USA.},
DOI = {10.1109/TII.2022.3179361},
ISSN = {1551-3203},
EISSN = {1941-0050},
Keywords = {Industrial Internet of Things; Training; Task analysis; Data models;
   Privacy; Differential privacy; Logistics; Data sharing; industrial IoTs;
