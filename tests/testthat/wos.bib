Title = {Best Practices for Ethical Sharing of Individual-Level Health Research
   Data From Low- and Middle-Income Settings},
Journal = {JOURNAL OF EMPIRICAL RESEARCH ON HUMAN RESEARCH ETHICS},
Year = {2015},
Volume = {10},
