Pages = {2739-2747},
Month = {NOV},
Note = {5th International Conference on Intelligent Data Engineeing and
   Automated Learning, Exeter, ENGLAND, AUG, 2004},
Abstract = {Data mining across different companies, organizations, online shops, or
   the likes is necessary so as to discover valuable shared patterns.
   associations, trends, or dependencies in their shared data. Privacy,
   however, is a concern. In many situations it is required that data
   mining should be conducted without any privacy being violated. In
   response to this requirement, in this paper we propose an effective
   distributed privacy-preserving data mining approach called SDDM. SDDM is
   characterized by its ability to resist collusion. Unless the number of
   colluding sites in a distributed system is larger than or equal to 4,
   privacy cannot be violated. Results of performance study demonstrated
   the effectiveness of SDDM.},
