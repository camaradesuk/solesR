@article{ WOS:000089225800003,
Author = {Mirkov, DM and Ilic, DB and Jaric, S},
Title = {Learning transfer of movement speed and accuracy: Effects of distance
   and direction},
Journal = {JOURNAL OF HUMAN MOVEMENT STUDIES},
Year = {2000},
Volume = {39},
Number = {4},
Pages = {237-248},
Abstract = {This study investigated the importance of the final position
   representation in motor programs of rapid, discrete movements. Twelve
   subjects (experimental group) were tested on rapid elbow flexion and
   extension movements performed over different distances, prior to and
   after an extensive practice of an elbow flexion movement. Both the
   tested movements and the practiced movement shared the same final
   position. Another twelve subjects (control group) were also tested but
   without any practice between the tests. When pre- and post-test were
   compared, a prominent practice associated improvement in movement
   variable errors recorded in the experimental group was transferred to
   flexion movements performed over other distances, while the same
   transfer to the movement performed in the opposite direction (i.e. elbow
   extensions) was small. Overall improvement in terms of variable errors
   recorded in all tasks of the control group was small when compared with
   the experimental group. In addition, the practice associated increase in
   movement velocity recorded in the experimental group demonstrated almost
   total transfer to movements performed over other distances, as well as
   in both directions. The control group demonstrated no change in movement
   velocity in any of the tested tasks. Therefore, the results obtained
   suggest that (a) the final position, rather than movement distance,
   could play an important role in motor programs of movements performed in
   a certain direction, wheras (b) a gain in movement speed attained due to
   an extensive practice of a rapid, discrete movement could be generalized
   to other rapid movements performed by the same muscle groups.},
