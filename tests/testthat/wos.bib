@article{ WOS:000516648000001,
Author = {Zou, Jia and Iyengar, Arun and Jermaine, Chris},
Title = {Architecture of a distributed storage that combines file system, memory
   and computation in a single layer},
Journal = {VLDB JOURNAL},
