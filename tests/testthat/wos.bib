@inproceedings{ WOS:000086093800006,
Author = {Andreev, AE and Clementi, AEF and Penna, P and Rolim, JDP},
Editor = {Meinel, C and Tison, S},
Title = {Memory organization schemes for large shared data: A randomized solution
   for distributed memory machines},
Booktitle = {STACS'99 - 16TH ANNUAL SYMPOSIUM ON THEORETICAL ASPECTS OF COMPUTER
   SCIENCE},
Series = {Lecture Notes in Computer Science},
Year = {1999},
Volume = {1563},
Pages = {68-77},
Note = {16th Annual Symposium on Theoretical Aspects of Computer Science, TRIER,
   GERMANY, MAR 04-06, 1999},
Organization = {Gessel Informatik, Special Interest Grp Theoret Comp Sci; Masion
   Informat Math Discretes},
Abstract = {We address the problem of organizing a set T of shared data into the
   memory modules of a Distributed Memory Machine (DMM) in order to
   minimize memory access conflicts during read operations.
   In this paper we present a new randomized scheme that, with high
   probability, performs any set of r unrelated read operations on the
   shared data set T in O(log r + log log
   \textbackslash{}T\textbackslash{}) parallel time with no memory
   conflicts and using O(r) processors. The set T is distributed into m DMM
   memory modules where m is polynomial in r and logarithmic in T, and the
   overall size of the shared memory used by our scheme is not larger than
   (1 + 1/log
   \textbackslash{}T\textbackslash{})\textbackslash{}T\textbackslash{}
   (this means that there is ``almost{''} no data replication). The memory
   organization scheme and most part of all the computations of our method
   do not depend on the read requests, so they can be performed once and
   for all during an off-line phase; This is a relevant improvement over
   the previous deterministic method recently given in {[}1] when
   ``real-time{''} applications are considered.},
