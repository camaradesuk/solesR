Pages = {431-442},
Month = {DEC 30},
Abstract = {This study investigates variations in the adoption of different
   organizational practices and productivity using a survey of the Canadian
   primary textile industry. The results suggest that monitoring and
   profit-sharing are substitutes. The effectiveness of these practices in
