@article{ WOS:000366143800012,
Author = {Womack, Ryan P.},
Title = {Research Data in Core Journals in Biology, Chemistry, Mathematics, and
   Physics},
Journal = {PLOS ONE},
Year = {2015},
Volume = {10},
Number = {12},
Month = {DEC 4},
Abstract = {This study takes a stratified random sample of articles published in
   2014 from the top 10 journals in the disciplines of biology, chemistry,
   mathematics, and physics, as ranked by impact factor. Sampled articles
   were examined for their reporting of original data or reuse of prior
   data, and were coded for whether the data was publicly shared or
   otherwise made available to readers. Other characteristics such as the
   sharing of software code used for analysis and use of data citation and
   DOIs for data were examined. The study finds that data sharing practices
   are still relatively rare in these disciplines' top journals, but that
   the disciplines have markedly different practices. Biology top journals
   share original data at the highest rate, and physics top journals share
   at the lowest rate. Overall, the study finds that within the top
   journals, only 13\% of articles with original data published in 2014
   make the data available to others.},
