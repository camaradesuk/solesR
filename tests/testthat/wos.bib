@article{ WOS:000722626600002,
Author = {Guo, Qiusong and Sun, Ling and Liu, Guiqiong and Jiang, Xunping and Liu,
   Junrui and Li, Jihua and Chen, Zhuo},
Title = {MSBBS: A sheep breeding system based on blockchain},
Journal = {SMALL RUMINANT RESEARCH},
Year = {2021},
Volume = {205},
Month = {DEC},
Abstract = {Joint breeding is an important way to develop new breeds, and the
   establishment of genetic data sharing channels among breeding farms
   plays an essential role in the joint breeding of sheep. To meet the
   needs of sharing genetic data and selecting breeding sheep in the
   process of joint breeding, in our study, we constructed a sheep
   blockchain breeding system (MSBBS) with distributed storage using
   blockchain technology. The breeding farms in the alliance were set as
   nodes, and a set of MSBBS was installed on each node to record breeding
   sheep data, automatically calculate Estimated Breeding Value (EBV), and
   write elite sheep data into the blockchain to realize real-time sharing
   of block data. blocks should be authenticated by more than two-thirds of
   nodes before they were written, and after writing, each node will get
   the same copy of the block data, so that the block data cannot be
   tampered with. MSBBS facilitates sheep farms' data management, and the
   block data could be used as reliable and shared genetic data for
   selection of breeding sheep.},
