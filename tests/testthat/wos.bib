@article{ WOS:000546677400009,
Author = {De Porre, Kevin and Myter, Florian and Scholliers, Christophe and Boix,
   Elisa Gonzalez},
Title = {CScript: A distributed programming language for building
   mixed-consistency applications},
Journal = {JOURNAL OF PARALLEL AND DISTRIBUTED COMPUTING},
Year = {2020},
Volume = {144},
Pages = {109-123},
Month = {OCT},
Abstract = {Current programming models only provide abstractions for sharing data
   under a homogeneous consistency model. It is, however, not uncommon for
   a distributed application to provide strong consistency for one part of
   the shared data and eventual consistency for another part. Because
   mixing consistency models is not supported by current programming
   models, writing such applications is extremely difficult. In this paper
   we propose CScript, a distributed object-oriented programming language
   with built-in support for data replication. At its core are consistent
   and available replicated objects. CScript regulates the interactions
   between these objects to avoid subtle inconsistencies that arise when
   mixing consistency models. Our evaluation compares a collaborative text
   editor built atop CScript with a state-of-the-art implementation. The
   results show that our approach is flexible and more memory efficient.
   (C) 2020 Elsevier Inc. All rights reserved.},
