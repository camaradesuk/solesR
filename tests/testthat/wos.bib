@article{ WOS:000377868300020,
Author = {Sahal, Radhya and Khafagy, Mohamed H. and Omara, Fatma A.},
Title = {Comparative Study of Multi-query Optimization Techniques using Shared
   Predicate-based for Big Data},
Journal = {INTERNATIONAL JOURNAL OF GRID AND DISTRIBUTED COMPUTING},
Year = {2016},
Volume = {9},
Number = {5},
Pages = {229-240},
Month = {MAY},
Abstract = {Big data analytical systems, such as MapReduce, have become main issues
   for many enterprises and research groups. Currently, multi-query which
   translated into MapReduce jobs is submitted repeatedly with similar
   tasks. So, exploiting these similar tasks can offer possibilities to
   avoid repeated computations of MapReduce jobs. Therefore, many
   researches have addressed the sharing opportunity to optimize multi
   query processing. Consequently, the main goal of this work is to study
   and compare comprehensively two existed sharing opportunity techniques
   using predicate-based filters; MRShare and relaxed MRShare. The
   comparative study has been performed over TPC-H benchmark and confirmed
   that the relaxed MRShare technique significantly outperforms the MRShare
   for shared data in terms of predicate-based filters among multi-query.},
