@article{ WOS:000487146500001,
Author = {Stoddart, Linda},
Title = {Determining the impact of knowledge sharing initiatives in international
   organizations: Case studies},
Journal = {IFLA JOURNAL-INTERNATIONAL FEDERATION OF LIBRARY ASSOCIATIONS},
Year = {2020},
Volume = {46},
Number = {1, SI},
Pages = {64-71},
Month = {MAR},
Abstract = {No one disputes that knowledge is the lifeblood of international
   organizations and especially specialized agencies of the United Nations.
   However, there has been little consensus on the best methods to share
   knowledge, leverage the extensive international expertise and make it
   available to the constituents and partners of these organizations. What
   is their strategy for managing knowledge? Do they have one? What impact
   does it have? What is the role of senior management in championing
   knowledge sharing in these international organizations? These are the
   questions this paper addresses through the lenses of the evaluations of
   current knowledge sharing practices in two institutions located in
   Geneva, Switzerland, both part of the United Nations system.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
